[Unit]
Description=Scout Feishu feedback listener
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/workspace/signal-feed
EnvironmentFile=%h/workspace/signal-feed/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/uv run --locked python -m scout --listen-feedback
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target

