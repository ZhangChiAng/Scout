[Unit]
Description=Scout personalized Juya article delivery
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/workspace/scout
EnvironmentFile=%h/workspace/scout/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=%h/.local/bin/uv run --locked python -m scout --send --scheduled
