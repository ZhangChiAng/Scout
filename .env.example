# ChatGPT subscription authentication is managed by the official Codex SDK.
# Run: uv run --locked python -m scout.auth login
# Optional isolated credential/runtime directory; defaults to the path below.
# SCOUT_CODEX_HOME=~/.local/share/scout/codex

# App credentials are required by --listen-feedback; all four values are
# required by --send and --calibrate. Use a published custom app.
FEISHU_APP_ID=cli_replace-with-app-id
FEISHU_APP_SECRET=replace-with-app-secret
FEISHU_RECEIVE_ID_TYPE=chat_id
FEISHU_RECEIVE_ID=oc_replace-with-chat-id

# Optional: defaults to data/scout.sqlite3.
SCOUT_DB_PATH=data/scout.sqlite3
# Optional local Zhihu collector. Cookies stay in the collector project.
# ZHIHU_COLLECTOR_URL=http://127.0.0.1:8765
# ZHIHU_COLLECTOR_TOKEN=replace-with-the-collector-bearer-token
