+    def save_question_page(self, run: dict, records: list[dict]):
+        """Commit ordered additions and their resume cursor as one SQLite transaction."""
+        with self.db:
+            ordinal = self.db.execute(
+                "SELECT COALESCE(MAX(ordinal),-1)+1 FROM records WHERE run_id=?", (run["id"],)
+            ).fetchone()[0]
+            for item in records:
+                changed = self.db.execute(
+                    "INSERT OR IGNORE INTO records VALUES (?,?,?,?)",
+                    (run["id"], f"{item['content_type']}:{item['content_id']}", ordinal,
+                     json.dumps(item, ensure_ascii=False)),
+                ).rowcount
+                ordinal += changed
+            self.db.execute(
+                "INSERT OR REPLACE INTO docs VALUES ('run',?,?)",
+                (run["id"], json.dumps(run, ensure_ascii=False)),
+            )
